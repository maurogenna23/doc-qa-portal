# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Pinecone (required) ---------------------------------------------------
# API key from https://app.pinecone.io -> API Keys (starts with "pcsk_")
PINECONE_API_KEY=
# Name of a SERVERLESS index with dimension 1536 and metric "cosine".
PINECONE_INDEX=doc-qa
# Optional logical partition inside the index. Leave blank for the default.
PINECONE_NAMESPACE=
# Only read by `npm run setup:pinecone` when creating the index.
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- LLM + embeddings (required) -------------------------------------------
# Any OpenAI-compatible provider. Swap LLM_BASE_URL to point at Groq,
# Together, OpenRouter, etc. without touching application code.
LLM_API_KEY=
LLM_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
# Must match the dimension of the Pinecone index above.
EMBEDDING_DIMENSIONS=1536
COMPLETION_MODEL=gpt-4.1-mini

# --- Cost + safety guardrails (optional, sensible defaults in code) --------
MAX_OUTPUT_TOKENS=500
MAX_CONTEXT_CHARS=8000
# Minimum cosine score for a chunk to be used. 0 disables the filter.
MIN_SCORE=0

# --- API Gateway throttling (optional, deploy only) ------------------------
API_RATE_LIMIT=10
API_BURST_LIMIT=20
# Ceiling on concurrent async ingest workers, and so on concurrent provider calls.
INGEST_WORKER_CONCURRENCY=5

# --- Ingest mode (optional) ------------------------------------------------
# "sync"  -> POST /ingest chunks + embeds + upserts inline (default)
# "async" -> POST /ingest writes to S3, publishes to SQS, worker Lambda ingests
INGEST_MODE=sync
INGEST_BUCKET=
INGEST_QUEUE_URL=

# --- Local dev only --------------------------------------------------------
PORT=4000
