{
  "name": "@docqa/api",
  "version": "1.0.0",
  "private": true,
  "description": "RAG core, provider adapters and Lambda handlers for the Doc Q&A portal",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/local/server.ts",
    "setup:pinecone": "tsx src/scripts/ensure-index.ts",
    "eval": "tsx src/scripts/evaluate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/client-sqs": "^3.1143.0",
    "@docqa/contracts": "*",
    "@pinecone-database/pinecone": "^9.0.0",
    "openai": "^7.25.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^20.17.10",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
