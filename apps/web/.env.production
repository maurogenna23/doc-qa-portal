# Base URL of the deployed Doc Q&A API.
#
# Not a secret: it is a public, unauthenticated endpoint, and the browser sends
# it in the clear on every request anyway. Committing it keeps the production
# build reproducible from a clone, with no dashboard configuration to remember.
#
# To point a deployment at a different API, set NEXT_PUBLIC_API_BASE_URL as an
# environment variable in the hosting platform: it overrides this file.
NEXT_PUBLIC_API_BASE_URL=https://rq3ifuxj51.execute-api.us-east-1.amazonaws.com
